{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uzlinux Studio",
  "version": "0.1.0",
  "identifier": "com.uzlinux.studio",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Uzlinux Studio - Ulanzi D200",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
