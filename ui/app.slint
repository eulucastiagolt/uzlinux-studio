import { Button, Slider, LineEdit, ComboBox, ScrollView } from "std-widgets.slint";

export struct KeyItem {
    id: int,
    col: int,
    row: int,
    pos_str: string,
    title: string,
    action_type: string,
    action_value: string,
    icon_path: string,
    has_icon: bool,
    icon: image,
    is_pressed: bool,
    is_selected: bool,
}

export struct SystemAppItem {
    name: string,
    exec_cmd: string,
    icon_path: string,
    has_icon: bool,
    icon: image,
}

export struct AppCategoryItem {
    id: int,
    name: string,
    count: int,
    is_expanded: bool,
}

export struct IconItem {
    name: string,
    category: string,
    path: string,
    has_image: bool,
    image: image,
}

export struct IconCategoryItem {
    id: int,
    name: string,
    count: int,
    is_expanded: bool,
}

export struct IconGridItem {
    name: string,
    category: string,
    path: string,
    has_image: bool,
    image: image,
}

export struct IconGridRow {
    item_0_valid: bool, item_0: IconGridItem,
    item_1_valid: bool, item_1: IconGridItem,
    item_2_valid: bool, item_2: IconGridItem,
    item_3_valid: bool, item_3: IconGridItem,
    item_4_valid: bool, item_4: IconGridItem,
    item_5_valid: bool, item_5: IconGridItem,
    item_6_valid: bool, item_6: IconGridItem,
    item_7_valid: bool, item_7: IconGridItem,
}

export struct PageItem {
    id: int,
    name: string,
    is_active: bool,
}

export struct ProfileItem {
    id: string,
    name: string,
    is_active: bool,
}

export global DnDHelper {
    pure callback to_transfer(string) -> data-transfer;
    pure callback accept(data-transfer) -> bool;
    pure callback text_of(data-transfer) -> string;
}

// 8-Column Grid Tile component faithful to Ulanzi Studio (screenshot media_1792187430752_6f1ad25c.png)
component IconTile inherits Rectangle {
    in property <IconGridItem> item;
    callback clicked(string);

    width: 44px;
    height: 44px;
    border-radius: 6px;
    background: tile_touch.has-hover ? #2e3547 : #32353e;
    border-width: 1px;
    border-color: tile_touch.has-hover ? #00FFE6 : #3a3d46;

    if item.has_image: Image {
        source: item.image;
        width: 28px;
        height: 28px;
        image-fit: contain;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !item.has_image: Text {
        text: "?";
        font-size: 11px;
        color: #64748b;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    DragArea {
        width: 100%;
        height: 100%;
        allow-copy: true;
        allow-move: true;
        enabled: root.item.path != "";
        data: DnDHelper.to_transfer("icon:" + root.item.path);

        tile_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked(root.item.path);
            }
        }
    }
}

// 8-Column Row View
component IconGridRowView inherits HorizontalLayout {
    in property <IconGridRow> row_data;
    callback icon_clicked(string);

    spacing: 8px;
    alignment: start;

    if row_data.item_0_valid: IconTile {
        item: row_data.item_0;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_1_valid: IconTile {
        item: row_data.item_1;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_2_valid: IconTile {
        item: row_data.item_2;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_3_valid: IconTile {
        item: row_data.item_3;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_4_valid: IconTile {
        item: row_data.item_4;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_5_valid: IconTile {
        item: row_data.item_5;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_6_valid: IconTile {
        item: row_data.item_6;
        clicked(p) => { root.icon_clicked(p); }
    }
    if row_data.item_7_valid: IconTile {
        item: row_data.item_7;
        clicked(p) => { root.icon_clicked(p); }
    }
}

// System Application Row for Categorized App Library & Search
component SystemAppRow inherits Rectangle {
    in property <SystemAppItem> app;
    callback select_clicked;

    height: 52px;
    border-radius: 8px;
    background: row_touch.has-hover ? #2e3547 : #151821;
    border-width: 1px;
    border-color: row_touch.has-hover ? #00FFE6 : #232733;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Icon container with slight rounding
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: #1e222d;

                if root.app.has_icon: Image {
                    source: root.app.icon;
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !root.app.has_icon: Text {
                    text: "⚙";
                    font-size: 15px;
                    color: #64748b;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.app.name;
                    font-size: 13px;
                    font-weight: 600;
                    color: #f1f5f9;
                }
                Text {
                    text: root.app.exec_cmd;
                    font-size: 11px;
                    color: #64748b;
                    overflow: elide;
                }
            }
        }

        // Selecionar pill button
        Rectangle {
            width: 88px;
            height: 30px;
            border-radius: 6px;
            background: btn_touch.has-hover ? #00FFE622 : #282a32;
            border-width: 1px;
            border-color: btn_touch.has-hover ? #00FFE6 : #383b45;

            Text {
                text: "Selecionar";
                font-size: 12px;
                font-weight: 600;
                color: btn_touch.has-hover ? #00FFE6 : #cbd5e1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            btn_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select_clicked(); }
            }
        }
    }

    DragArea {
        width: 100%;
        height: 100%;
        allow-copy: true;
        allow-move: true;
        data: DnDHelper.to_transfer("app:" + root.app.name + "\n" + root.app.exec_cmd + "\n" + root.app.icon_path);

        row_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.select_clicked();
            }
        }
    }
}

// Custom Deck Key Button Component (Faithful to Ulanzi Studio & Physical D200)
component DeckKeyButton inherits Rectangle {
    in property <KeyItem> key_data;
    callback clicked;
    callback dropped(string);

    width: 78px;
    height: 78px;
    border-radius: 12px;
    background: key_data.is_pressed ? #0f172a :
                dropper.has-drag ? #00FFE628 :
                key_data.is_selected ? #212328 :
                touch.has-hover ? #2a2c34 : #1e2025;
    border-width: (dropper.has-drag || key_data.is_selected) ? 2px : 1px;
    border-color: dropper.has-drag ? #00FFE6 :
                  key_data.is_selected ? #00FFE6 :
                  touch.has-hover ? #3c3f4a : #2b2d35;

    // Inside Content: Empty/Inactive Key
    if key_data.action_type == "" && !key_data.has_icon: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: key_data.is_selected ? #00FFE6 : transparent;
            opacity: 0.4;
            horizontal-stretch: 0;
        }
    }

    // Inside Content: Configured Key
    if key_data.action_type != "" || key_data.has_icon: VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 4px;
        padding-right: 4px;

        // Has Title mode: Icon 46x46 in upper area, title at bottom
        if key_data.title != "": VerticalLayout {
            alignment: space-between;

            Rectangle {
                width: 46px;
                height: 46px;
                x: (parent.width - self.width) / 2;

                if key_data.has_icon: Image {
                    source: key_data.icon;
                    width: 46px;
                    height: 46px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !key_data.has_icon: Image {
                    source: key_data.action_type == "app" ? @image-url("../assets/ulanzi_official/actions/open.svg") :
                            key_data.action_type == "command" ? @image-url("../assets/ulanzi_official/actions/actionTrigger.svg") :
                            key_data.action_type == "website" ? @image-url("../assets/ulanzi_official/actions/website.svg") :
                            key_data.action_type == "hotkey" ? @image-url("../assets/ulanzi_official/actions/hotkey.svg") :
                            key_data.action_type == "media" ? @image-url("../assets/ulanzi_official/actions/media_play_pause.svg") :
                            key_data.action_type == "sound" ? @image-url("../assets/ulanzi_official/actions/playAudio.svg") :
                            key_data.action_type == "multiaction" ? @image-url("../assets/ulanzi_official/actions/multiAction.svg") :
                            key_data.action_type == "obs" ? @image-url("../assets/ulanzi_official/actions/obsstudio.svg") :
                            key_data.action_type == "close" ? @image-url("../assets/ulanzi_official/actions/close.svg") :
                            @image-url("../assets/ulanzi_official/actions/icon.svg");
                    width: 42px;
                    height: 42px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: key_data.title;
                font-size: 11px;
                font-weight: 600;
                color: #ffffff;
                horizontal-alignment: center;
                overflow: elide;
                height: 14px;
            }
        }

        // Icon-only mode (No Title): Large 54x54 icon centered
        if key_data.title == "": VerticalLayout {
            alignment: center;

            Rectangle {
                width: 54px;
                height: 54px;
                x: (parent.width - self.width) / 2;

                if key_data.has_icon: Image {
                    source: key_data.icon;
                    width: 54px;
                    height: 54px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !key_data.has_icon: Image {
                    source: key_data.action_type == "app" ? @image-url("../assets/ulanzi_official/actions/open.svg") :
                            key_data.action_type == "command" ? @image-url("../assets/ulanzi_official/actions/actionTrigger.svg") :
                            key_data.action_type == "website" ? @image-url("../assets/ulanzi_official/actions/website.svg") :
                            key_data.action_type == "hotkey" ? @image-url("../assets/ulanzi_official/actions/hotkey.svg") :
                            key_data.action_type == "media" ? @image-url("../assets/ulanzi_official/actions/media_play_pause.svg") :
                            key_data.action_type == "sound" ? @image-url("../assets/ulanzi_official/actions/playAudio.svg") :
                            key_data.action_type == "multiaction" ? @image-url("../assets/ulanzi_official/actions/multiAction.svg") :
                            key_data.action_type == "obs" ? @image-url("../assets/ulanzi_official/actions/obsstudio.svg") :
                            key_data.action_type == "close" ? @image-url("../assets/ulanzi_official/actions/close.svg") :
                            @image-url("../assets/ulanzi_official/actions/icon.svg");
                    width: 48px;
                    height: 48px;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    dropper := DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => {
            DnDHelper.accept(event.data) ? DragAction.copy : DragAction.none
        }
        dropped(event) => {
            root.dropped(DnDHelper.text_of(event.data));
            return event.proposed-action;
        }

        dragger := DragArea {
            width: 100%;
            height: 100%;
            allow-copy: true;
            allow-move: true;
            data: DnDHelper.to_transfer("key:" + root.key_data.id);

            touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

// Custom Deck Wide Key Button Component (Bottom Right Slot 13 - Clock & Wide Action)
component DeckWideKeyButton inherits Rectangle {
    in property <KeyItem> key_data;
    in property <string> current_time_str: "12 : 00";
    callback clicked;
    callback dropped(string);

    width: 166px;
    height: 78px;
    border-radius: 12px;
    background: key_data.is_pressed ? #0f172a :
                dropper.has-drag ? #00FFE628 :
                key_data.is_selected ? #212328 :
                touch.has-hover ? #2a2c34 : #121316;
    border-width: (dropper.has-drag || key_data.is_selected) ? 2px : 1px;
    border-color: dropper.has-drag ? #00FFE6 :
                  key_data.is_selected ? #00FFE6 :
                  touch.has-hover ? #3c3f4a : #2b2d35;

    // Clock display (Native D200 clock mode - faithful to physical D200 & Ulanzi Studio)
    if key_data.action_type == "clock" || (key_data.action_type == "" && !key_data.has_icon): HorizontalLayout {
        padding: 8px;
        spacing: 14px;
        alignment: center;

        // Realistic Analog Clock dial widget
        Rectangle {
            width: 46px;
            height: 46px;
            border-radius: 23px;
            background: #090a0d;
            border-width: 1.5px;
            border-color: #00FFE6;
            y: (parent.height - self.height) / 2;

            // Center pin
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: #ffffff;
                x: 21px;
                y: 21px;
            }

            // Hour hand
            Rectangle {
                width: 2.5px;
                height: 12px;
                border-radius: 1px;
                background: #f8fafc;
                x: 21.75px;
                y: 11px;
            }

            // Minute hand
            Rectangle {
                width: 1.5px;
                height: 17px;
                border-radius: 1px;
                background: #00FFE6;
                x: 22.25px;
                y: 7px;
            }

            // Second hand (orange)
            Rectangle {
                width: 1px;
                height: 20px;
                background: #f97316;
                x: 22.5px;
                y: 5px;
            }

            // 12 o'clock tick
            Rectangle {
                width: 2px;
                height: 4px;
                background: #cbd5e1;
                x: 22px;
                y: 2px;
            }
            // 6 o'clock tick
            Rectangle {
                width: 2px;
                height: 4px;
                background: #cbd5e1;
                x: 22px;
                y: 40px;
            }
            // 9 o'clock tick
            Rectangle {
                width: 4px;
                height: 2px;
                background: #cbd5e1;
                x: 2px;
                y: 22px;
            }
            // 3 o'clock tick
            Rectangle {
                width: 4px;
                height: 2px;
                background: #cbd5e1;
                x: 40px;
                y: 22px;
            }
        }

        // Digital time display
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.current_time_str;
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
                vertical-alignment: center;
            }
            Text {
                text: "D200 CLOCK";
                font-size: 9px;
                font-weight: 700;
                color: #00FFE6;
                letter-spacing: 1.5px;
            }
        }
    }

    // Hardware System Stats Monitor on Wide Key (CPU% & RAM% live gauges)
    if key_data.action_type == "system_stats": HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: "CPU";
                font-size: 10px;
                font-weight: 800;
                color: #00FFE6;
            }
            Text {
                text: "RAM";
                font-size: 10px;
                font-weight: 800;
                color: #38bdf8;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.current_time_str;
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
            }
            Text {
                text: "MONITOR D200";
                font-size: 9px;
                font-weight: 700;
                color: #00FFE6;
                letter-spacing: 1px;
            }
        }
    }

    // Custom Action & Icon on Wide Key (if clock/stats mode overridden)
    if key_data.action_type != "clock" && key_data.action_type != "system_stats" && (key_data.has_icon || key_data.action_type != ""): VerticalLayout {
        padding: 6px;
        spacing: 2px;
        alignment: center;

        if key_data.has_icon: Image {
            source: key_data.icon;
            width: 42px;
            height: 42px;
            image-fit: contain;
            horizontal-alignment: center;
        }

        Text {
            text: key_data.title != "" ? key_data.title : key_data.action_value;
            font-size: 11px;
            font-weight: 600;
            color: #ffffff;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    dropper := DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => {
            DnDHelper.accept(event.data) ? DragAction.copy : DragAction.none
        }
        dropped(event) => {
            root.dropped(DnDHelper.text_of(event.data));
            return event.proposed-action;
        }

        dragger := DragArea {
            width: 100%;
            height: 100%;
            allow-copy: true;
            allow-move: true;
            data: DnDHelper.to_transfer("key:13");

            touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

// Preset button for quick action assignment
component PresetButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? #373a43 : #282a31;
    border-width: 1px;
    border-color: touch.has-hover ? #00FFE6 : #3a3d47;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 500;
            color: touch.has-hover ? #00FFE6 : #e2e8f0;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Sidebar Action Library Item Component (Faithful to Ulanzi Studio)
component SidebarActionItem inherits Rectangle {
    in property <image> icon_image;
    in property <bool> has_icon: true;
    in property <string> label;
    in property <string> description;
    in property <bool> is_active: false;
    in property <string> drag_payload: "";
    callback clicked;

    height: 46px;
    border-radius: 8px;
    background: is_active ? #252830 : (touch.has-hover ? #2a2d36 : transparent);
    border-width: is_active ? 1.5px : (touch.has-hover ? 1px : 0px);
    border-color: is_active ? #00FFE6 : #3a3d47;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;

        // Dedicated 28x28 Icon Container Badge
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: is_active ? #00FFE622 : #252730;
            border-width: 1px;
            border-color: is_active ? #00FFE6 : #323540;
            y: (parent.height - self.height) / 2;

            if root.has_icon: Image {
                source: root.icon_image;
                width: 18px;
                height: 18px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: root.is_active ? #00FFE6 : #f1f5f9;
                vertical-alignment: center;
            }
            if root.description != "": Text {
                text: root.description;
                font-size: 10px;
                color: #94a3b8;
                vertical-alignment: center;
            }
        }
    }

    DragArea {
        width: 100%;
        height: 100%;
        allow-copy: true;
        allow-move: true;
        enabled: root.drag_payload != "";
        data: DnDHelper.to_transfer(root.drag_payload);

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Uzlinux Studio - Ulanzi Deck Companion";
    preferred-width: 1060px;
    preferred-height: 740px;
    min-width: 960px;
    min-height: 640px;
    background: #18191b;
    default-font-family: "sans-serif";

    in-out property <bool> device_connected: false;
    in-out property <string> device_model: "Ulanzi D200";
    in-out property <string> device_node: "/dev/hidraw0";
    in-out property <int> brightness_val: 70;
    in-out property <int> sleep_val: 300;
    in-out property <bool> udev_missing: false;
    in-out property <string> status_message: "Pronto";
    in-out property <string> current_time_str: "12 : 00";

    // 15 keys model (0 to 14)
    in-out property <[KeyItem]> keys: [];
    in-out property <int> selected_key_index: 0;

    // Selected key editable fields
    in-out property <string> edit_title: "";
    in-out property <string> edit_action_type: "app";
    in-out property <string> edit_action_value: "";
    in-out property <string> edit_icon_path: "";
    in-out property <bool> edit_has_icon: false;
    in-out property <image> edit_icon_preview;

    // Public method to update pressed state
    public function set_key_pressed(idx: int, pressed: bool) {
        if (idx >= 0 && idx < root.keys.length) {
            root.keys[idx].is_pressed = pressed;
        }
    }

    // App picker properties & state
    in-out property <bool> show_app_picker: false;
    in-out property <string> app_filter_text: "";
    in-out property <bool> is_searching_apps: false;
    in-out property <int> active_app_category_id: 0;
    in-out property <int> app_search_result_count: 0;
    in-out property <[AppCategoryItem]> app_categories: [];
    in-out property <[SystemAppItem]> category_apps: [];
    in-out property <[SystemAppItem]> filtered_apps: [];

    // Icon Library Modal properties & state (categorized accordion & marketplace)
    in-out property <bool> show_icon_library: false;
    in-out property <string> icon_filter_text: "";
    in-out property <bool> is_searching_icons: false;
    in-out property <int> active_category_id: 0;
    in-out property <[IconCategoryItem]> icon_categories: [];
    in-out property <[IconGridRow]> category_icon_rows: [];
    in-out property <[IconGridRow]> search_icon_rows: [];
    in-out property <int> search_result_count: 0;
    in-out property <[IconItem]> filtered_icons: [];

    // Settings Page / Dialog state
    in-out property <bool> show_settings_dialog: false;
    in-out property <int> settings_tab_index: 0; // 0: Firmware & Dispositivo, 1: Preferências Gerais, 2: Sobre
    in-out property <string> device_firmware_version: "v1.0.0";
    in-out property <string> device_serial_number: "D200-OFICIAL";
    in-out property <bool> is_checking_firmware: false;
    in-out property <string> firmware_check_message: "";
    in-out property <bool> firmware_has_update: false;
    in-out property <string> firmware_latest_version: "";
    in-out property <string> firmware_changelog: "";
    in-out property <string> firmware_download_url: "";
    in-out property <bool> autostart_enabled: false;
    in-out property <string> app_version_string: "0.1.0";
    in-out property <string> profiles_dir_path: "~/.config/uzlinux-studio";
    in-out property <string> icons_dir_path: "~/.config/uzlinux-studio/icons";

    // Profile & Multi-Page management state
    in-out property <[ProfileItem]> profiles_list: [];
    in-out property <string> current_profile_name: "Padrão";
    in-out property <bool> show_profile_dropdown: false;
    in-out property <bool> show_new_profile_dialog: false;
    in-out property <string> new_profile_input_text: "";
    in-out property <[PageItem]> pages: [];
    in-out property <int> current_page_index: 0;
    in-out property <int> total_pages_count: 1;

    // Profile & Page callbacks
    callback switch_profile(string);
    callback create_profile(string);
    callback duplicate_profile(string);
    callback delete_profile(string);
    callback switch_page(int);
    callback add_page();
    callback delete_page(int);

    // Callbacks to Rust
    callback key_selected(int);
    callback save_key_action(int, string, string, string, string, string);
    callback action_type_changed(int, string);
    callback action_value_changed(int, string);
    callback title_changed(int, string);
    callback apply_preset(int, string, string, string);
    callback clear_key_action(int);
    callback brightness_changed(int);
    callback sleep_changed(int);
    callback send_key_image_to_deck(int);
    callback refresh_connection();
    callback browse_icon_custom();
    callback browse_icon_system();
    callback browse_icon_ulanzi();
    callback clear_key_icon();
    callback icon_path_edited(string);
    callback open_app_picker();
    callback close_app_picker();
    callback toggle_app_category_expanded(int);
    callback app_filter_changed(string);
    callback app_selected(string, string, string);
    callback open_icon_library();
    callback close_icon_library();
    callback toggle_category_expanded(int);
    callback icon_filter_changed(string);
    callback icon_chosen(string);
    callback open_marketplace();
    callback import_icon_pack();
    callback browse_app_binary();
    callback browse_command_script();
    callback browse_audio_file();
    callback request_install_udev();
    callback open_settings_dialog();
    callback close_settings_dialog();
    callback switch_settings_tab(int);
    callback check_firmware_updates();
    callback toggle_autostart(bool);
    callback open_profiles_folder();
    callback open_icons_folder();
    callback open_firmware_download_link();
    callback open_github_repo();
    callback key_payload_dropped(int, string);

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // 1. TOP HEADER BAR (Faithful to Ulanzi Studio Qt Layout)
        Rectangle {
            height: 54px;
            background: #1e2025;
            border-radius: 12px;
            border-width: 1px;
            border-color: #2b2e37;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                alignment: space-between;

                // Logo and Brand Title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: #00FFE6;
                        y: 11px;

                        Text {
                            text: "U";
                            font-weight: 900;
                            font-size: 18px;
                            color: #18191b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "Ulanzi Studio";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.device_connected ? #00FFE6 : #ef4444;
                                y: 3px;
                            }

                            Text {
                                text: root.device_connected ? (root.device_model + " Conectado (" + root.device_node + ")") : "Dispositivo Desconectado";
                                font-size: 11px;
                                color: root.device_connected ? #a7f3d0 : #fca5a5;
                            }
                        }
                    }

                    Rectangle { width: 4px; }

                    // Profile Selector Trigger Pill
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: prof_touch.has-hover ? #2e313c : #252831;
                        border-width: 1px;
                        border-color: root.show_profile_dropdown ? #00FFE6 : (prof_touch.has-hover ? #00FFE688 : #373a46);
                        y: 11px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/ulanzi_official/actions/profile.svg");
                                width: 14px;
                                height: 14px;
                                image-fit: contain;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.current_profile_name;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.show_profile_dropdown ? #00FFE6 : #e2e8f0;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "▾";
                                font-size: 11px;
                                font-weight: 700;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                        }

                        prof_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show_profile_dropdown = !root.show_profile_dropdown;
                            }
                        }
                    }
                }

                // Header Controls (Brightness, USB Permissions, Reconnect)
                HorizontalLayout {
                    spacing: 16px;
                    alignment: end;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Image {
                            source: @image-url("../assets/ulanzi_official/actions/brightness.svg");
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Brilho:";
                            color: #94a3b8;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Slider {
                            width: 110px;
                            minimum: 0;
                            maximum: 100;
                            value: root.brightness_val;
                            changed(val) => {
                                root.brightness_val = Math.round(val);
                                root.brightness_changed(root.brightness_val);
                            }
                        }

                        Text {
                            text: root.brightness_val + "%";
                            color: #f1f5f9;
                            font-size: 12px;
                            width: 34px;
                            vertical-alignment: center;
                        }
                    }

                    if root.udev_missing: Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: udev_touch.has-hover ? #c2410c : #ea580c;
                        y: 12px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: "Configurar USB (udev)";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        udev_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.request_install_udev();
                            }
                        }
                    }

                    Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: rec_touch.has-hover ? #373a45 : #282a32;
                        border-width: 1px;
                        border-color: rec_touch.has-hover ? #00FFE6 : #3a3d47;
                        y: 12px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text {
                                text: "Reconectar";
                                font-size: 12px;
                                font-weight: 600;
                                color: rec_touch.has-hover ? #00FFE6 : #e2e8f0;
                                vertical-alignment: center;
                            }
                        }

                        rec_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.refresh_connection();
                            }
                        }
                    }

                    // Settings Button
                    Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: set_touch.has-hover ? #373a45 : #282a32;
                        border-width: 1px;
                        border-color: set_touch.has-hover ? #00FFE6 : #3a3d47;
                        y: 12px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/ulanzi_official/actions/settings.svg");
                                width: 14px;
                                height: 14px;
                                image-fit: contain;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Configurações";
                                font-size: 12px;
                                font-weight: 600;
                                color: set_touch.has-hover ? #00FFE6 : #e2e8f0;
                                vertical-alignment: center;
                            }
                        }

                        set_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open_settings_dialog();
                            }
                        }
                    }
                }
            }
        }

        // 2. MAIN WORKSPACE AREA: CENTER (DEVICE MOCKUP + INSPECTOR) + RIGHT (ACTIONS SIDEBAR)
        HorizontalLayout {
            spacing: 14px;

            // CENTER COLUMN: DECK HARDWARE MOCKUP + PROPERTY INSPECTOR
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 14px;

                // A. HARDWARE DECK MOCKUP CHASSIS (Exact 1:1 to Ulanzi Studio & Physical D200)
                Rectangle {
                    background: #34363e;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: #40434c;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: center;

                        // Top Brand Bezel Label ("U · STUDIO")
                        Text {
                            text: "U · S T U D I O";
                            font-size: 12px;
                            font-weight: 800;
                            color: #d6d8de;
                            horizontal-alignment: center;
                            letter-spacing: 2px;
                        }

                        // 5x3 Hardware Keypad (Row 0, Row 1, Row 2 with Double-Width Slot 13)
                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;

                            // Row 0: 5 Square Keys
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;
                                for key in [root.keys[0], root.keys[1], root.keys[2], root.keys[3], root.keys[4]]:
                                    DeckKeyButton {
                                        key_data: key;
                                        clicked => {
                                            root.key_selected(key.id);
                                        }
                                        dropped(txt) => {
                                            root.key_payload_dropped(key.id, txt);
                                        }
                                    }
                            }

                            // Row 1: 5 Square Keys
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;
                                for key in [root.keys[5], root.keys[6], root.keys[7], root.keys[8], root.keys[9]]:
                                    DeckKeyButton {
                                        key_data: key;
                                        clicked => {
                                            root.key_selected(key.id);
                                        }
                                        dropped(txt) => {
                                            root.key_payload_dropped(key.id, txt);
                                        }
                                    }
                            }

                            // Row 2: 3 Square Keys + 1 Wide Key (Slot 13 - Clock & Wide Screen)
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;

                                for key in [root.keys[10], root.keys[11], root.keys[12]]:
                                    DeckKeyButton {
                                        key_data: key;
                                        clicked => {
                                            root.key_selected(key.id);
                                        }
                                        dropped(txt) => {
                                            root.key_payload_dropped(key.id, txt);
                                        }
                                    }

                                // Double-Width Slot 13 (Wide Clock / Action Display)
                                DeckWideKeyButton {
                                    key_data: root.keys[13];
                                    current_time_str: root.current_time_str;
                                    clicked => {
                                        root.key_selected(13);
                                    }
                                    dropped(txt) => {
                                        root.key_payload_dropped(13, txt);
                                    }
                                }
                            }
                        }

                        // Dynamic Pagination Pill Indicator (Exact capsule shape from Ulanzi Studio)
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            Rectangle {
                                height: 26px;
                                border-radius: 13px;
                                background: #282a32;
                                border-width: 1px;
                                border-color: #383b46;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    spacing: 4px;
                                    alignment: center;

                                    for page in root.pages: Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: page.is_active ? #00FFE6 : (page_pill_touch.has-hover ? #3e4250 : transparent);

                                        Text {
                                            text: (page.id + 1);
                                            font-size: 11px;
                                            font-weight: page.is_active ? 800 : 600;
                                            color: page.is_active ? #18191b : (page_pill_touch.has-hover ? #ffffff : #94a3b8);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        page_pill_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.switch_page(page.id);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 24px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: add_page_touch.has-hover ? #3e4250 : transparent;

                                        Text {
                                            text: "+";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: add_page_touch.has-hover ? #00FFE6 : #9c9c9c;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        add_page_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.add_page();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.pages.length > 1: Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: del_page_btn.has-hover ? #7f1d1d : #282a32;
                                border-width: 1px;
                                border-color: del_page_btn.has-hover ? #ef4444 : #383b46;

                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/trash.svg");
                                    width: 12px;
                                    height: 12px;
                                    image-fit: contain;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                del_page_btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.delete_page(root.current_page_index);
                                    }
                                }
                            }
                        }
                    }
                }

                // B. PROPERTY INSPECTOR (Exact 1:1 to Ulanzi Studio screenshot)
                Rectangle {
                    vertical-stretch: 0;
                    height: 188px;
                    background: #1e2025;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2b2e37;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: start;

                        // Inspector Header Line (Category Subtitle + Clear Button)
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: (root.edit_action_type == "" || root.edit_action_type == "none") ?
                                      "System: Tecla Desativada" :
                                      root.edit_action_type == "page.next" ? "Navegação: Próxima Página" :
                                      root.edit_action_type == "page.prev" ? "Navegação: Página Anterior" :
                                      root.edit_action_type == "page.goto" ? "Navegação: Ir para Página" :
                                      root.edit_action_type == "page.switch" ? "Navegação: Alternar Perfil" :
                                      root.edit_action_type == "hotkey" ? "System: Hotkey" :
                                      root.edit_action_type == "app" ? "System: Open Application" :
                                      root.edit_action_type == "close" ? "System: Close Window" :
                                      root.edit_action_type == "website" ? "System: Open Website" :
                                      root.edit_action_type == "text" ? "System: Type Precomposed Text" :
                                      root.edit_action_type == "command" ? "System: Linux Command" :
                                      root.edit_action_type == "media" ? "Multimedia: Player Control" :
                                      root.edit_action_type == "sound" ? "Soundboard: Play Audio" :
                                      root.edit_action_type == "multiaction" ? "Multi Action: Macro Sequence" :
                                      root.edit_action_type == "obs" ? "OBS Studio: Operation" :
                                      root.edit_action_type == "clock" ? "Hardware: Relógio D200" :
                                      root.edit_action_type == "system_stats" ? "Hardware: Monitor de Sistema D200" :
                                      "System: " + root.edit_action_type;
                                font-size: 12px;
                                font-weight: 500;
                                color: #9ca3af;
                                vertical-alignment: center;
                            }

                            // Clean Clear Button
                            Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: trash_touch.has-hover ? #ef444422 : transparent;
                                border-width: 1px;
                                border-color: trash_touch.has-hover ? #ef4444 : #373a45;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/ulanzi_official/actions/trash.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Limpar Tecla";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: trash_touch.has-hover ? #f87171 : #cbd5e1;
                                        vertical-alignment: center;
                                    }
                                }

                                trash_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.clear_key_action(root.selected_key_index);
                                    }
                                }
                            }
                        }

                        // Thin Divider Line
                        Rectangle {
                            height: 1px;
                            background: #2b2d35;
                        }

                        // Inspector Body: Left Key Preview Card + Right Title & Action Controls
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            // Left: Key Preview Tile & Buttons (Fixed width 74px)
                            VerticalLayout {
                                width: 74px;
                                spacing: 6px;
                                alignment: start;

                                Rectangle {
                                    width: 74px;
                                    height: 74px;
                                    border-radius: 10px;
                                    background: #18191c;
                                    border-width: 1.5px;
                                    border-color: preview_touch.has-hover ? #00FFE6 : #363842;

                                    VerticalLayout {
                                        padding: 4px;
                                        alignment: center;
                                        spacing: 2px;

                                        if root.edit_has_icon: Image {
                                            source: root.edit_icon_preview;
                                            width: root.edit_title != "" ? 44px : 52px;
                                            height: root.edit_title != "" ? 44px : 52px;
                                            image-fit: contain;
                                            horizontal-alignment: center;
                                        }

                                        if !root.edit_has_icon: Image {
                                            source: root.edit_action_type == "app" ? @image-url("../assets/ulanzi_official/actions/open.svg") :
                                                    root.edit_action_type == "command" ? @image-url("../assets/ulanzi_official/actions/actionTrigger.svg") :
                                                    root.edit_action_type == "website" ? @image-url("../assets/ulanzi_official/actions/website.svg") :
                                                    root.edit_action_type == "hotkey" ? @image-url("../assets/ulanzi_official/actions/hotkey.svg") :
                                                    root.edit_action_type == "media" ? @image-url("../assets/ulanzi_official/actions/media_play_pause.svg") :
                                                    root.edit_action_type == "sound" ? @image-url("../assets/ulanzi_official/actions/playAudio.svg") :
                                                    root.edit_action_type == "multiaction" ? @image-url("../assets/ulanzi_official/actions/multiAction.svg") :
                                                    root.edit_action_type == "obs" ? @image-url("../assets/ulanzi_official/actions/obsstudio.svg") :
                                                    root.edit_action_type == "close" ? @image-url("../assets/ulanzi_official/actions/close.svg") :
                                                    @image-url("../assets/ulanzi_official/actions/icon.svg");
                                            width: root.edit_title != "" ? 40px : 48px;
                                            height: root.edit_title != "" ? 40px : 48px;
                                            image-fit: contain;
                                            horizontal-alignment: center;
                                        }

                                        if root.edit_title != "": Text {
                                            text: root.edit_title;
                                            font-size: 10px;
                                            font-weight: 500;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    preview_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open_icon_library();
                                        }
                                    }
                                }

                                // Row with [Ícones] Button
                                Rectangle {
                                    width: 74px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: icon_lib_touch.has-hover ? #00FFE622 : #262830;
                                    border-width: 1px;
                                    border-color: icon_lib_touch.has-hover ? #00FFE6 : #363942;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Image {
                                            source: @image-url("../assets/ulanzi_official/actions/icon.svg");
                                            width: 14px;
                                            height: 14px;
                                            image-fit: contain;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Ícones";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #00FFE6;
                                            vertical-alignment: center;
                                        }
                                    }
                                    icon_lib_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open_icon_library(); }
                                    }
                                }

                                // Row with [Arquivo] and Clear Icon
                                HorizontalLayout {
                                    width: 74px;
                                    spacing: 4px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: icon_file_touch.has-hover ? #333640 : #262830;
                                        border-width: 1px;
                                        border-color: icon_file_touch.has-hover ? #38bdf8 : #363942;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/folder.svg");
                                                width: 13px;
                                                height: 13px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Arquivo";
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: #cbd5e1;
                                                vertical-alignment: center;
                                            }
                                        }
                                        icon_file_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.browse_icon_custom(); }
                                        }
                                    }

                                    if root.edit_has_icon: Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: icon_del_touch.has-hover ? #ef444433 : #262830;
                                        border-width: 1px;
                                        border-color: icon_del_touch.has-hover ? #ef4444 : #363942;
                                        Text {
                                            text: "✕";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #ef4444;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        icon_del_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.clear_key_icon(); }
                                        }
                                    }
                                }
                            }

                            // Right: Title & Action Configuration Form
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                alignment: start;

                                // Row 1: Title Input Row
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        width: 65px;
                                        alignment: center;
                                        Text {
                                            text: "Title:";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: #9ca3af;
                                        }
                                    }
                                    LineEdit {
                                        text: root.edit_title;
                                        placeholder-text: "Nome exibido na tecla...";
                                        edited(txt) => {
                                            root.edit_title = txt;
                                            root.title_changed(root.selected_key_index, txt);
                                        }
                                    }
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #282a32;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        Text {
                                            text: "T";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Row 2: Action Parameter Input Row
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        width: 65px;
                                        alignment: center;
                                        Text {
                                            text: root.edit_action_type == "page.goto" ? "Página:" :
                                                  root.edit_action_type == "page.next" || root.edit_action_type == "page.prev" || root.edit_action_type == "page.switch" ? "Navegar:" :
                                                  root.edit_action_type == "hotkey" ? "Hotkey:" :
                                                  root.edit_action_type == "app" ? "App:" :
                                                  root.edit_action_type == "close" ? "Processo:" :
                                                  root.edit_action_type == "website" ? "URL:" :
                                                  root.edit_action_type == "command" ? "Comando:" :
                                                  root.edit_action_type == "text" ? "Texto:" :
                                                  root.edit_action_type == "sound" ? "Áudio:" :
                                                  root.edit_action_type == "multiaction" ? "Macro:" :
                                                  root.edit_action_type == "obs" ? "Ação OBS:" :
                                                  root.edit_action_type == "clock" ? "Relógio:" :
                                                  root.edit_action_type == "system_stats" ? "Monitor:" :
                                                  "Ação:";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: #9ca3af;
                                        }
                                    }

                                    if root.edit_action_type == "" || root.edit_action_type == "none": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #333640;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/disable_key.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Tecla Desativada (Vazia) — Visor apagado no hardware.";
                                                font-size: 11px;
                                                color: #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type == "page.next": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/nextPage.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Avança para a próxima página de teclas do perfil atual.";
                                                font-size: 11px;
                                                color: #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type == "page.prev": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/previousPage.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Retorna para a página anterior de teclas do perfil atual.";
                                                font-size: 11px;
                                                color: #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type == "page.switch": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/switchProfile.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Alterna ciclicamente entre os perfis configurados no aplicativo.";
                                                font-size: 11px;
                                                color: #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type == "clock": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #00FFE6;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/btn_pageIndicator.png");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Modo Relógio Oficial D200 (Sincronização contínua com hardware).";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #00FFE6;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type == "system_stats": Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #18191c;
                                        border-width: 1px;
                                        border-color: #00FFE6;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;
                                            Image {
                                                source: @image-url("../assets/ulanzi_official/actions/audiomixer.png");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Modo Monitor D200 (CPU% e RAM% ao vivo no hardware).";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #00FFE6;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.edit_action_type != "" && root.edit_action_type != "none" && root.edit_action_type != "clock" && root.edit_action_type != "system_stats" && root.edit_action_type != "page.next" && root.edit_action_type != "page.prev" && root.edit_action_type != "page.switch": LineEdit {
                                        text: root.edit_action_value;
                                        placeholder-text: root.edit_action_type == "page.goto" ? "Número da página alvo (ex: 1, 2, 3...)" :
                                                          root.edit_action_type == "app" ? "Ex: firefox, spotify, discord..." :
                                                          root.edit_action_type == "close" ? "Ex: window (janela ativa) ou spotify, discord..." :
                                                          root.edit_action_type == "command" ? "Ex: pactl set-sink-mute @DEFAULT_SINK@ toggle" :
                                                          root.edit_action_type == "website" ? "Ex: https://youtube.com" :
                                                          root.edit_action_type == "hotkey" ? "Ex: ctrl+c, alt+Tab, Print..." :
                                                          root.edit_action_type == "sound" ? "Caminho do arquivo de áudio (.wav, .mp3, .ogg)..." :
                                                          root.edit_action_type == "multiaction" ? "Ex: ctrl+c; delay 200; ctrl+v" :
                                                          root.edit_action_type == "obs" ? "Ex: record, recordpause, stream, virtualcam, studiomode" :
                                                          "Digite o texto a ser enviado...";
                                        edited(txt) => {
                                            root.edit_action_value = txt;
                                            root.action_value_changed(root.selected_key_index, txt);
                                        }
                                    }
                                }

                                // Row 3: Presets (Aligned with input, indented by 65px + 8px = 73px)
                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;

                                    Rectangle {
                                        width: 65px;
                                        background: transparent;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        if root.edit_action_type == "page.goto": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Pág. 1";
                                                clicked => { root.apply_preset(root.selected_key_index, "page.goto", "1", "Página 1"); }
                                            }
                                            PresetButton {
                                                label: "Pág. 2";
                                                clicked => { root.apply_preset(root.selected_key_index, "page.goto", "2", "Página 2"); }
                                            }
                                            PresetButton {
                                                label: "Pág. 3";
                                                clicked => { root.apply_preset(root.selected_key_index, "page.goto", "3", "Página 3"); }
                                            }
                                            PresetButton {
                                                label: "Pág. 4";
                                                clicked => { root.apply_preset(root.selected_key_index, "page.goto", "4", "Página 4"); }
                                            }
                                        }

                                        if root.edit_action_type == "app": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Escolher App...";
                                                clicked => { root.open_app_picker(); }
                                            }
                                            PresetButton {
                                                label: "Binário (/usr/bin)...";
                                                clicked => { root.browse_app_binary(); }
                                            }
                                        }

                                        if root.edit_action_type == "close": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Janela Ativa";
                                                clicked => { root.apply_preset(root.selected_key_index, "close", "window", "Fechar Janela"); }
                                            }
                                            PresetButton {
                                                label: "Spotify";
                                                clicked => { root.apply_preset(root.selected_key_index, "close", "spotify", "Fechar Spotify"); }
                                            }
                                            PresetButton {
                                                label: "Discord";
                                                clicked => { root.apply_preset(root.selected_key_index, "close", "discord", "Fechar Discord"); }
                                            }
                                            PresetButton {
                                                label: "Steam";
                                                clicked => { root.apply_preset(root.selected_key_index, "close", "steam", "Fechar Steam"); }
                                            }
                                        }

                                        if root.edit_action_type == "sound": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Escolher Áudio...";
                                                clicked => { root.browse_audio_file(); }
                                            }
                                            PresetButton {
                                                label: "Parar Sons";
                                                clicked => { root.apply_preset(root.selected_key_index, "sound", "stop", "Parar Sons"); }
                                            }
                                        }

                                        if root.edit_action_type == "multiaction": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Copiar + Colar (delay 200ms)";
                                                clicked => { root.apply_preset(root.selected_key_index, "multiaction", "ctrl+c; delay 200; ctrl+v", "Copiar & Colar"); }
                                            }
                                            PresetButton {
                                                label: "YouTube + Tocar";
                                                clicked => { root.apply_preset(root.selected_key_index, "multiaction", "website:https://youtube.com; delay 1500; media:playpause", "Abrir & Tocar"); }
                                            }
                                        }

                                        if root.edit_action_type == "obs": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Gravar";
                                                clicked => { root.apply_preset(root.selected_key_index, "obs", "record", "Gravar"); }
                                            }
                                            PresetButton {
                                                label: "Pausar";
                                                clicked => { root.apply_preset(root.selected_key_index, "obs", "recordpause", "Pausar"); }
                                            }
                                            PresetButton {
                                                label: "Live";
                                                clicked => { root.apply_preset(root.selected_key_index, "obs", "stream", "Ao Vivo"); }
                                            }
                                            PresetButton {
                                                label: "Câmera";
                                                clicked => { root.apply_preset(root.selected_key_index, "obs", "virtualcam", "Câm. Virtual"); }
                                            }
                                            PresetButton {
                                                label: "Estúdio";
                                                clicked => { root.apply_preset(root.selected_key_index, "obs", "studiomode", "Estúdio"); }
                                            }
                                        }

                                        if root.edit_action_type == "command": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Selecionar Script (.sh)...";
                                                clicked => { root.browse_command_script(); }
                                            }
                                        }

                                        if root.edit_action_type == "website": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "YouTube";
                                                clicked => { root.apply_preset(root.selected_key_index, "website", "https://youtube.com", "YouTube"); }
                                            }
                                            PresetButton {
                                                label: "GitHub";
                                                clicked => { root.apply_preset(root.selected_key_index, "website", "https://github.com", "GitHub"); }
                                            }
                                            PresetButton {
                                                label: "Google";
                                                clicked => { root.apply_preset(root.selected_key_index, "website", "https://google.com", "Google"); }
                                            }
                                        }

                                        if root.edit_action_type == "hotkey": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Ctrl+C";
                                                clicked => { root.apply_preset(root.selected_key_index, "hotkey", "ctrl+c", "Copiar"); }
                                            }
                                            PresetButton {
                                                label: "Ctrl+V";
                                                clicked => { root.apply_preset(root.selected_key_index, "hotkey", "ctrl+v", "Colar"); }
                                            }
                                            PresetButton {
                                                label: "Alt+Tab";
                                                clicked => { root.apply_preset(root.selected_key_index, "hotkey", "alt+Tab", "Janela"); }
                                            }
                                            PresetButton {
                                                label: "Print";
                                                clicked => { root.apply_preset(root.selected_key_index, "hotkey", "Print", "Print"); }
                                            }
                                        }

                                        if root.edit_action_type == "media": HorizontalLayout {
                                            spacing: 6px;
                                            PresetButton {
                                                label: "Play/Pause";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "playpause", "Play/Pause"); }
                                            }
                                            PresetButton {
                                                label: "Anterior";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "prev", "Anterior"); }
                                            }
                                            PresetButton {
                                                label: "Próxima";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "next", "Próxima"); }
                                            }
                                            PresetButton {
                                                label: "Vol +";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "volup", "Vol +"); }
                                            }
                                            PresetButton {
                                                label: "Vol -";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "voldown", "Vol -"); }
                                            }
                                            PresetButton {
                                                label: "Mudo";
                                                clicked => { root.apply_preset(root.selected_key_index, "media", "mute", "Mudo"); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT COLUMN: ACTIONS LIBRARY SIDEBAR (Faithful to Ulanzi Studio)
            Rectangle {
                width: 275px;
                background: #1e2025;
                border-radius: 14px;
                border-width: 1px;
                border-color: #2b2e37;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Biblioteca de Ações";
                            font-size: 13px;
                            font-weight: 700;
                            color: #cbd5e1;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #2b2e37;
                    }

                    // Action Categories List
                    ScrollView {
                        VerticalLayout {
                            padding-left: 2px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Category: Sistema
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/system.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "SISTEMA";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/disable_key.svg");
                                label: "Desativar Tecla";
                                description: "Deixar tecla vazia / sem ação";
                                drag_payload: "action:none::";
                                is_active: root.edit_action_type == "" || root.edit_action_type == "none";
                                clicked => {
                                    root.clear_key_action(root.selected_key_index);
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/open.svg");
                                label: "Aplicativo";
                                description: "Abrir app instalado no Linux";
                                drag_payload: "action:app::Aplicativo";
                                is_active: root.edit_action_type == "app";
                                clicked => {
                                    root.edit_action_type = "app";
                                    root.action_type_changed(root.selected_key_index, "app");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/close.svg");
                                label: "Fechar Janela";
                                description: "Fechar janela ativa ou processo";
                                drag_payload: "action:close:window:Fechar Janela";
                                is_active: root.edit_action_type == "close";
                                clicked => {
                                    root.edit_action_type = "close";
                                    root.apply_preset(root.selected_key_index, "close", "window", "Fechar Janela");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/hotkey.svg");
                                label: "Atalho de Teclado";
                                description: "Simular combinação de teclas";
                                drag_payload: "action:hotkey:ctrl+alt+t:Atalho";
                                is_active: root.edit_action_type == "hotkey";
                                clicked => {
                                    root.edit_action_type = "hotkey";
                                    root.action_type_changed(root.selected_key_index, "hotkey");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/website.svg");
                                label: "Website URL";
                                description: "Abrir link no navegador";
                                drag_payload: "action:website:https://:Website";
                                is_active: root.edit_action_type == "website";
                                clicked => {
                                    root.edit_action_type = "website";
                                    root.action_type_changed(root.selected_key_index, "website");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/text.svg");
                                label: "Digitar Texto";
                                description: "Digitar texto automático";
                                drag_payload: "action:text::Texto";
                                is_active: root.edit_action_type == "text";
                                clicked => {
                                    root.edit_action_type = "text";
                                    root.action_type_changed(root.selected_key_index, "text");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/actionTrigger.svg");
                                label: "Comando Linux";
                                description: "Executar comando ou shell script";
                                drag_payload: "action:command::Script";
                                is_active: root.edit_action_type == "command";
                                clicked => {
                                    root.edit_action_type = "command";
                                    root.action_type_changed(root.selected_key_index, "command");
                                }
                            }

                            // Category: Multimídia
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/multimedia.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "MULTIMÍDIA";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_play_pause.svg");
                                label: "Play / Pause";
                                description: "Tocar ou pausar música";
                                drag_payload: "action:media:playpause:Play/Pause";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "playpause", "Play/Pause");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_next.svg");
                                label: "Próxima Faixa";
                                description: "Avançar música";
                                drag_payload: "action:media:next:Próxima";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "next", "Próxima");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_prev.svg");
                                label: "Faixa Anterior";
                                description: "Voltar música";
                                drag_payload: "action:media:prev:Anterior";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "prev", "Anterior");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_vol_up.svg");
                                label: "Aumentar Volume";
                                description: "PipeWire / PulseAudio";
                                drag_payload: "action:media:volup:Vol +";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "volup", "Vol +");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_vol_down.svg");
                                label: "Diminuir Volume";
                                description: "PipeWire / PulseAudio";
                                drag_payload: "action:media:voldown:Vol -";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "voldown", "Vol -");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_mute.svg");
                                label: "Alternar Mudo";
                                description: "Silenciar áudio do PC";
                                drag_payload: "action:media:mute:Mudo";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "mute", "Mudo");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/media_stop.svg");
                                label: "Parar Reprodução";
                                description: "Parar áudio ativo";
                                drag_payload: "action:media:stop:Parar";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "media", "stop", "Parar");
                                }
                            }

                            // Category: Soundboard
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/sound.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "SOUNDBOARD";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/playAudio.svg");
                                label: "Tocar Áudio";
                                description: "Efeito sonoro / sound bite";
                                drag_payload: "action:sound::Tocar Som";
                                is_active: root.edit_action_type == "sound";
                                clicked => {
                                    root.edit_action_type = "sound";
                                    root.action_type_changed(root.selected_key_index, "sound");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/stopAudio.svg");
                                label: "Parar Áudios";
                                description: "Interromper todos os efeitos";
                                drag_payload: "action:sound:stop:Parar Sons";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "sound", "stop", "Parar Sons");
                                }
                            }

                            // Category: Multi Action
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/multiAction.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "MULTI ACTION";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/multiAction.svg");
                                label: "Sequência Macro";
                                description: "Executar múltiplos comandos em sequência";
                                drag_payload: "action:multiaction::Macro";
                                is_active: root.edit_action_type == "multiaction";
                                clicked => {
                                    root.edit_action_type = "multiaction";
                                    root.action_type_changed(root.selected_key_index, "multiaction");
                                }
                            }

                            // Category: OBS Studio
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/obsstudio.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "OBS STUDIO";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/record.svg");
                                label: "Gravar Vídeo";
                                description: "Iniciar ou parar gravação";
                                drag_payload: "action:obs:record:Gravar";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "obs", "record", "Gravar");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/recordpause.svg");
                                label: "Pausar Gravação";
                                description: "Pausar ou continuar gravação";
                                drag_payload: "action:obs:recordpause:Pausar";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "obs", "recordpause", "Pausar");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/stream.svg");
                                label: "Transmissão ao Vivo";
                                description: "Iniciar ou parar live stream";
                                drag_payload: "action:obs:stream:Ao Vivo";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "obs", "stream", "Ao Vivo");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/virtualcam.svg");
                                label: "Câmera Virtual";
                                description: "Ligar ou desligar câm virtual";
                                drag_payload: "action:obs:virtualcam:Câm. Virtual";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "obs", "virtualcam", "Câm. Virtual");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/studiomode.svg");
                                label: "Modo Estúdio";
                                description: "Alternar modo estúdio";
                                drag_payload: "action:obs:studiomode:Estúdio";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "obs", "studiomode", "Estúdio");
                                }
                            }

                            // Category: Hardware D200
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/dial.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "HARDWARE D200";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/btn_pageIndicator.png");
                                label: "Relógio Oficial D200";
                                description: "Mostrador analógico + digital";
                                drag_payload: "action:clock:clock:Relógio";
                                is_active: root.edit_action_type == "clock";
                                clicked => {
                                    root.edit_action_type = "clock";
                                    root.apply_preset(root.selected_key_index, "clock", "clock", "Relógio");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/audiomixer.png");
                                label: "Monitor de Sistema";
                                description: "Medidores de CPU% e RAM% ao vivo";
                                drag_payload: "action:system_stats:stats:Monitor CPU";
                                is_active: root.edit_action_type == "system_stats";
                                clicked => {
                                    root.edit_action_type = "system_stats";
                                    root.apply_preset(root.selected_key_index, "system_stats", "stats", "Monitor CPU");
                                }
                            }

                            // Category: Páginas e Navegação
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/page.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "PÁGINAS E NAVEGAÇÃO";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #64748b;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/nextPage.svg");
                                label: "Próxima Página";
                                description: "Avançar para a próxima página";
                                drag_payload: "action:page.next:next:Próxima";
                                is_active: root.edit_action_type == "page.next";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "page.next", "next", "Próxima");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/previousPage.svg");
                                label: "Página Anterior";
                                description: "Voltar para a página anterior";
                                drag_payload: "action:page.prev:prev:Anterior";
                                is_active: root.edit_action_type == "page.prev";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "page.prev", "prev", "Anterior");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/goToPage.svg");
                                label: "Ir para Página";
                                description: "Pular direto para página específica";
                                drag_payload: "action:page.goto:1:Página 1";
                                is_active: root.edit_action_type == "page.goto";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "page.goto", "1", "Página 1");
                                }
                            }

                            SidebarActionItem {
                                icon_image: @image-url("../assets/ulanzi_official/actions/switchProfile.svg");
                                label: "Alternar Perfil";
                                description: "Mudar para o próximo perfil";
                                drag_payload: "action:page.switch:next:Alternar Perfil";
                                is_active: root.edit_action_type == "page.switch";
                                clicked => {
                                    root.apply_preset(root.selected_key_index, "page.switch", "next", "Alternar Perfil");
                                }
                            }
                        }
                    }
                }
            }
        }

        // 3. FOOTER STATUS BAR
        Rectangle {
            height: 28px;
            background: #1e2025;
            border-radius: 8px;
            border-width: 1px;
            border-color: #2b2e37;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #00FFE6;
                        y: 11px;
                    }
                    Text {
                        text: root.status_message;
                        font-size: 11px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Uzlinux Studio • Compatível com Firmware Oficial D200 • Linux";
                    font-size: 11px;
                    color: #475569;
                    vertical-alignment: center;
                }
            }
        }
    }

    // 4. MODAL APP PICKER OVERLAY (Categorized FreeDesktop Accordion & Search)
    if root.show_app_picker: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        backdrop_app_touch := TouchArea {
            clicked => { root.close_app_picker(); }
        }

        Rectangle {
            width: Math.min(root.width - 60px, 720px);
            height: Math.min(root.height - 60px, 560px);
            background: #1e2025;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #00FFE6;

            TouchArea {} // Blocks clicks through to backdrop

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../assets/ulanzi_official/actions/btn_open.png");
                            width: 20px;
                            height: 20px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Escolher Aplicativo Instalado no Linux";
                            font-size: 15px;
                            font-weight: 700;
                            color: #f8fafc;
                            vertical-alignment: center;
                        }
                    }
                    Button {
                        text: "Fechar";
                        clicked => { root.close_app_picker(); }
                    }
                }

                LineEdit {
                    text: root.app_filter_text;
                    placeholder-text: "Buscar aplicativo (ex: spotify, discord, steam, chrome)...";
                    edited(txt) => {
                        root.app_filter_text = txt;
                        root.app_filter_changed(txt);
                    }
                }

                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;

                        if root.is_searching_apps: VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text {
                                text: "Resultados da busca (" + root.app_search_result_count + " aplicativos encontrados):";
                                font-size: 12px;
                                color: #00FFE6;
                                font-weight: 600;
                            }

                            for app in root.filtered_apps: SystemAppRow {
                                app: app;
                                select_clicked => {
                                    root.app_selected(app.name, app.exec_cmd, app.icon_path);
                                }
                            }
                        }

                        if !root.is_searching_apps: VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            for cat in root.app_categories: VerticalLayout {
                                spacing: 4px;

                                // Category Accordion Header
                                Rectangle {
                                    height: 38px;
                                    border-radius: 6px;
                                    background: app_cat_touch.has-hover ? #2a2c35 : (cat.is_expanded ? #23252d : #1d1e24);
                                    border-width: 1px;
                                    border-color: cat.is_expanded ? #00FFE644 : #282a33;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            Text {
                                                text: cat.is_expanded ? "⌃" : "⌄";
                                                font-size: 14px;
                                                font-weight: 700;
                                                color: cat.is_expanded ? #00FFE6 : #94a3b8;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: cat.name + " (" + cat.count + ")";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #f1f5f9;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    app_cat_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle_app_category_expanded(cat.id);
                                        }
                                    }
                                }

                                // Expanded Category Apps
                                if cat.is_expanded: VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 6px;
                                    padding-bottom: 10px;
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    for app in root.category_apps: SystemAppRow {
                                        app: app;
                                        select_clicked => {
                                            root.app_selected(app.name, app.exec_cmd, app.icon_path);
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #252830;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 5. MODAL ICON LIBRARY (Faithful recreation of Ulanzi Studio & screenshot media_1792187430752_6f1ad25c.png)
    if root.show_icon_library: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        backdrop_touch := TouchArea {
            clicked => { root.close_icon_library(); }
        }

        Rectangle {
            width: Math.min(root.width - 40px, 490px);
            height: Math.min(root.height - 40px, 640px);
            background: #1e2025;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #383b45;

            TouchArea {} // Blocks clicks through to backdrop

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Modal Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../assets/ulanzi_official/actions/icon.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Icon Library";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Marketplace Button
                        Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: mkt_touch.has-hover ? #00FFE622 : #282a32;
                            border-width: 1px;
                            border-color: mkt_touch.has-hover ? #00FFE6 : #383b45;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/website.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Marketplace";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: mkt_touch.has-hover ? #00FFE6 : #cbd5e1;
                                    vertical-alignment: center;
                                }
                            }
                            mkt_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open_marketplace(); }
                            }
                        }

                        // Import Pack (.zip) Button
                        Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: import_touch.has-hover ? #00FFE622 : #282a32;
                            border-width: 1px;
                            border-color: import_touch.has-hover ? #00FFE6 : #383b45;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/ulanzi_official/actions/open.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Importar (.zip)";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: import_touch.has-hover ? #00FFE6 : #cbd5e1;
                                    vertical-alignment: center;
                                }
                            }
                            import_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.import_icon_pack(); }
                            }
                        }

                        // Close Button
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: close_icon_touch.has-hover ? #ef444433 : #282a32;
                            border-width: 1px;
                            border-color: #383b45;

                            Text {
                                text: "✕";
                                font-size: 13px;
                                color: close_icon_touch.has-hover ? #ef4444 : #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close_icon_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close_icon_library(); }
                            }
                        }
                    }
                }

                // Header Divider
                Rectangle {
                    height: 1px;
                    background: #2b2e37;
                }

                // Search Icon Bar
                LineEdit {
                    text: root.icon_filter_text;
                    placeholder-text: "Search Icon...";
                    edited(txt) => {
                        root.icon_filter_text = txt;
                        root.icon_filter_changed(txt);
                    }
                }

                // Scrollable Content: Categories Accordion or Search Results
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;

                        if root.is_searching_icons: VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text {
                                text: "Resultados da busca (" + root.search_result_count + " ícones encontrados):";
                                font-size: 12px;
                                color: #00FFE6;
                                font-weight: 600;
                            }

                            for row in root.search_icon_rows: IconGridRowView {
                                row_data: row;
                                icon_clicked(p) => { root.icon_chosen(p); }
                            }
                        }

                        if !root.is_searching_icons: VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            for cat in root.icon_categories: VerticalLayout {
                                spacing: 4px;

                                // Category Accordion Header
                                Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: cat_touch.has-hover ? #2a2c35 : (cat.is_expanded ? #23252d : #1d1e24);
                                    border-width: 1px;
                                    border-color: cat.is_expanded ? #00FFE644 : #282a33;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            Text {
                                                text: cat.is_expanded ? "⌃" : "⌄";
                                                font-size: 14px;
                                                font-weight: 700;
                                                color: cat.is_expanded ? #00FFE6 : #94a3b8;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: cat.name + " (" + cat.count + ")";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #f1f5f9;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    cat_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle_category_expanded(cat.id);
                                        }
                                    }
                                }

                                // 8-Column Grid when Category is Expanded
                                if cat.is_expanded: VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 10px;
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    for row in root.category_icon_rows: IconGridRowView {
                                        row_data: row;
                                        icon_clicked(p) => { root.icon_chosen(p); }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #252830;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 6. PROFILE DROPDOWN POPOVER
    if root.show_profile_dropdown: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => {
                root.show_profile_dropdown = false;
            }
        }

        Rectangle {
            x: 230px;
            y: 62px;
            width: 240px;
            background: #1e2025;
            border-radius: 10px;
            border-width: 1px;
            border-color: #383b47;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000aa;

            TouchArea {} // Blocks click through

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    alignment: space-between;

                    Text {
                        text: "PERFIS DO ULANZI DECK";
                        font-size: 10px;
                        font-weight: 700;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }

                    Text {
                        text: root.profiles_list.length;
                        font-size: 10px;
                        font-weight: 700;
                        color: #00FFE6;
                    }
                }

                for prof in root.profiles_list: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: prof.is_active ? #00FFE61c : (item_touch.has-hover ? #2a2d36 : transparent);
                    border-width: prof.is_active ? 1px : 0;
                    border-color: #00FFE644;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Image {
                                source: @image-url("../assets/ulanzi_official/actions/profile.svg");
                                width: 13px;
                                height: 13px;
                                image-fit: contain;
                                vertical-alignment: center;
                            }

                            Text {
                                text: prof.name;
                                font-size: 12px;
                                font-weight: prof.is_active ? 700 : 500;
                                color: prof.is_active ? #00FFE6 : #e2e8f0;
                                vertical-alignment: center;
                            }
                        }

                        if prof.is_active: Text {
                            text: "✓";
                            font-size: 12px;
                            font-weight: 800;
                            color: #00FFE6;
                            vertical-alignment: center;
                        }
                    }

                    item_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_profile_dropdown = false;
                            root.switch_profile(prof.name);
                        }
                    }
                }

                Rectangle { height: 1px; background: #2f323c; }

                // Actions: Criar Novo, Duplicar, Excluir
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: new_p_touch.has-hover ? #2a2d36 : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;

                        Text { text: "+"; font-size: 14px; font-weight: 700; color: #00FFE6; vertical-alignment: center; }
                        Text { text: "Criar Novo Perfil..."; font-size: 12px; color: #e2e8f0; vertical-alignment: center; }
                    }

                    new_p_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_profile_dropdown = false;
                            root.new_profile_input_text = "";
                            root.show_new_profile_dialog = true;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: dup_p_touch.has-hover ? #2a2d36 : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;

                        Text { text: "⎘"; font-size: 13px; font-weight: 700; color: #94a3b8; vertical-alignment: center; }
                        Text { text: "Duplicar Perfil Atual"; font-size: 12px; color: #e2e8f0; vertical-alignment: center; }
                    }

                    dup_p_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_profile_dropdown = false;
                            root.duplicate_profile(root.current_profile_name);
                        }
                    }
                }

                if root.profiles_list.length > 1: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: del_p_touch.has-hover ? #7f1d1d44 : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/ulanzi_official/actions/trash.svg");
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }

                        Text { text: "Excluir Este Perfil"; font-size: 12px; color: #fca5a5; vertical-alignment: center; }
                    }

                    del_p_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_profile_dropdown = false;
                            root.delete_profile(root.current_profile_name);
                        }
                    }
                }
            }
        }
    }

    // 7. MODAL CRIAR NOVO PERFIL
    if root.show_new_profile_dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.show_new_profile_dialog = false;
            }
        }

        Rectangle {
            width: 380px;
            background: #1e2025;
            border-radius: 14px;
            border-width: 1px;
            border-color: #383b45;

            TouchArea {} // Blocks clicks through

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: #00FFE622;
                        border-width: 1px;
                        border-color: #00FFE6;

                        Image {
                            source: @image-url("../assets/ulanzi_official/actions/profile.svg");
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Criar Novo Perfil";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: "Crie um perfil personalizado para o Deck";
                            font-size: 11px;
                            color: #94a3b8;
                        }
                    }
                }

                Text {
                    text: "Nome do Perfil:";
                    font-size: 12px;
                    font-weight: 600;
                    color: #cbd5e1;
                }

                LineEdit {
                    text <=> root.new_profile_input_text;
                    placeholder-text: "Ex: Streaming, Edição, Produtividade, Games...";
                }

                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: cancel_np_touch.has-hover ? #373a45 : #282a32;
                        border-width: 1px;
                        border-color: #3a3d47;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e2e8f0;
                                vertical-alignment: center;
                            }
                        }

                        cancel_np_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_new_profile_dialog = false; }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: confirm_np_touch.has-hover ? #00d6c2 : #00FFE6;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: center;
                            Text {
                                text: "Criar Perfil";
                                font-size: 12px;
                                font-weight: 700;
                                color: #18191b;
                                vertical-alignment: center;
                            }
                        }

                        confirm_np_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show_new_profile_dialog = false;
                                root.create_profile(root.new_profile_input_text);
                            }
                        }
                    }
                }
            }
        }
    }

    // 8. MODAL SETTINGS DIALOG (Firmware inspection, OTA update check & Linux preferences)
    if root.show_settings_dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        settings_backdrop_touch := TouchArea {
            clicked => { root.close_settings_dialog(); }
        }

        Rectangle {
            width: Math.min(root.width - 40px, 660px);
            height: Math.min(root.height - 40px, 620px);
            background: #1e2025;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: #383b45;

            TouchArea {} // Blocks clicks through to backdrop

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                // Modal Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #00FFE622;
                            border-width: 1px;
                            border-color: #00FFE6;

                            Image {
                                source: @image-url("../assets/ulanzi_official/actions/settings.svg");
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Configurações do Aplicativo";
                                font-size: 16px;
                                font-weight: 700;
                                color: #ffffff;
                            }
                            Text {
                                text: "Gerenciamento de hardware, firmware OTA e sistema";
                                font-size: 11px;
                                color: #94a3b8;
                            }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 8px;
                        background: close_settings_touch.has-hover ? #ef444433 : #282a32;
                        border-width: 1px;
                        border-color: #383b45;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 700;
                            color: close_settings_touch.has-hover ? #ef4444 : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close_settings_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_settings_dialog(); }
                        }
                    }
                }

                // Tab Selector Bar
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: #16171a;
                    border-width: 1px;
                    border-color: #2b2e37;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 4px;

                        // Tab 0: Firmware & Hardware
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.settings_tab_index == 0 ? #282a32 : (tab0_touch.has-hover ? #1f2128 : transparent);
                            border-width: root.settings_tab_index == 0 ? 1px : 0px;
                            border-color: #00FFE666;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "Dispositivo & Firmware";
                                    font-size: 12px;
                                    font-weight: root.settings_tab_index == 0 ? 700 : 500;
                                    color: root.settings_tab_index == 0 ? #00FFE6 : #94a3b8;
                                    vertical-alignment: center;
                                }
                            }

                            tab0_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.switch_settings_tab(0); }
                            }
                        }

                        // Tab 1: Sistema & Preferências
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.settings_tab_index == 1 ? #282a32 : (tab1_touch.has-hover ? #1f2128 : transparent);
                            border-width: root.settings_tab_index == 1 ? 1px : 0px;
                            border-color: #00FFE666;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "Preferências do Sistema";
                                    font-size: 12px;
                                    font-weight: root.settings_tab_index == 1 ? 700 : 500;
                                    color: root.settings_tab_index == 1 ? #00FFE6 : #94a3b8;
                                    vertical-alignment: center;
                                }
                            }

                            tab1_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.switch_settings_tab(1); }
                            }
                        }

                        // Tab 2: Sobre
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.settings_tab_index == 2 ? #282a32 : (tab2_touch.has-hover ? #1f2128 : transparent);
                            border-width: root.settings_tab_index == 2 ? 1px : 0px;
                            border-color: #00FFE666;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "Sobre";
                                    font-size: 12px;
                                    font-weight: root.settings_tab_index == 2 ? 700 : 500;
                                    color: root.settings_tab_index == 2 ? #00FFE6 : #94a3b8;
                                    vertical-alignment: center;
                                }
                            }

                            tab2_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.switch_settings_tab(2); }
                            }
                        }
                    }
                }

                // Tab Content Scroll Area
                Flickable {

                    // TAB 0: DISPOSITIVO & FIRMWARE
                    if root.settings_tab_index == 0: VerticalLayout {
                        spacing: 12px;
                        padding-top: 4px;
                        padding-bottom: 8px;

                        // Card: Hardware Status
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "Hardware Conectado";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #f1f5f9;
                                }

                                Rectangle { height: 1px; background: #2f323c; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Modelo do Deck:"; font-size: 12px; color: #94a3b8; }
                                    Text { text: root.device_model; font-size: 12px; font-weight: 600; color: #ffffff; }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Nó USB HID:"; font-size: 12px; color: #94a3b8; }
                                    Text { text: root.device_connected ? root.device_node : "Nenhum"; font-size: 12px; color: #38bdf8; }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Status de Comunicação:"; font-size: 12px; color: #94a3b8; }
                                    Text {
                                        text: root.device_connected ? "✓ Conectado e Operacional" : "✗ Desconectado";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.device_connected ? #34d399 : #f87171;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Serial Number (SN):"; font-size: 12px; color: #94a3b8; }
                                    Text { text: root.device_serial_number; font-size: 12px; color: #cbd5e1; }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Versão Atual do Firmware:"; font-size: 12px; color: #94a3b8; }
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        background: #00FFE622;
                                        border-width: 1px;
                                        border-color: #00FFE688;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.device_firmware_version;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #00FFE6;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Card: OTA Cloud Firmware Check
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Atualizações de Firmware (Nuvem Ulanzi)";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #f1f5f9;
                                        }
                                        Text {
                                            text: "Consulte o servidor oficial de OTA da Ulanzi para o seu D200";
                                            font-size: 11px;
                                            color: #94a3b8;
                                        }
                                    }

                                    // Check Button
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: check_fw_touch.has-hover ? #00d5c0 : #00FFE6;
                                        opacity: root.is_checking_firmware ? 0.6 : 1.0;

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: center;
                                            Text {
                                                text: root.is_checking_firmware ? "Verificando..." : "Verificar Atualização";
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #18191b;
                                                vertical-alignment: center;
                                            }
                                        }

                                        check_fw_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            enabled: !root.is_checking_firmware;
                                            clicked => { root.check_firmware_updates(); }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: #2f323c; }

                                // Status Result Box
                                if root.firmware_check_message != "": Rectangle {
                                    border-radius: 8px;
                                    background: root.firmware_has_update ? #04785722 : #1b2028;
                                    border-width: 1px;
                                    border-color: root.firmware_has_update ? #10b981 : #374151;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            Text {
                                                text: root.firmware_has_update ? "⚡" : "✓";
                                                font-size: 14px;
                                                color: root.firmware_has_update ? #34d399 : #38bdf8;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: root.firmware_check_message;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: root.firmware_has_update ? #34d399 : #e2e8f0;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if root.firmware_has_update && root.firmware_changelog != "": Text {
                                            text: root.firmware_changelog;
                                            font-size: 11px;
                                            color: #94a3b8;
                                        }

                                        if root.firmware_has_update && root.firmware_download_url != "": Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: dl_touch.has-hover ? #2563eb : #1d4ed8;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                alignment: center;
                                                Text {
                                                    text: "Baixar Pacote de Atualização (.bin)";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            dl_touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_firmware_download_link(); }
                                            }
                                        }
                                    }
                                }

                                if root.firmware_check_message == "": HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "ℹ Clique em 'Verificar Atualização' para consultar os servidores de OTA.";
                                        font-size: 11px;
                                        color: #64748b;
                                    }
                                }
                            }
                        }
                    }

                    // TAB 1: PREFERÊNCIAS DO SISTEMA
                    if root.settings_tab_index == 1: VerticalLayout {
                        spacing: 12px;
                        padding-top: 4px;
                        padding-bottom: 8px;

                        // Card: Autostart
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Iniciar com o Linux (Autostart)";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #f1f5f9;
                                        }
                                        Text {
                                            text: "Inicia o Uzlinux Studio automaticamente ao fazer login na sua sessão Linux.";
                                            font-size: 11px;
                                            color: #94a3b8;
                                        }
                                    }

                                    // Switch Toggle Button
                                    Rectangle {
                                        width: 52px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: root.autostart_enabled ? #00FFE6 : #373a45;
                                        border-width: 1px;
                                        border-color: root.autostart_enabled ? #00FFE6 : #4b5563;

                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.autostart_enabled ? #18191b : #ffffff;
                                            x: root.autostart_enabled ? 26px : 3px;
                                            y: 2px;
                                        }

                                        autostart_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.toggle_autostart(!root.autostart_enabled);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Card: Screen Sleep Timeout
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Tempo de Suspensão da Tela";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #f1f5f9;
                                    }
                                    Text {
                                        text: "Desliga os displays do D200 após período sem interação para preservar a vida útil:";
                                        font-size: 11px;
                                        color: #94a3b8;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    // 1 min (60s)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.sleep_val == 60 ? #00FFE6 : (s60_touch.has-hover ? #2e323d : #1e2025);
                                        border-width: 1px;
                                        border-color: root.sleep_val == 60 ? #00FFE6 : #383b45;
                                        Text {
                                            text: "1 min";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.sleep_val == 60 ? #18191b : #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s60_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.sleep_changed(60); }
                                        }
                                    }

                                    // 5 min (300s)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.sleep_val == 300 ? #00FFE6 : (s300_touch.has-hover ? #2e323d : #1e2025);
                                        border-width: 1px;
                                        border-color: root.sleep_val == 300 ? #00FFE6 : #383b45;
                                        Text {
                                            text: "5 min";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.sleep_val == 300 ? #18191b : #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s300_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.sleep_changed(300); }
                                        }
                                    }

                                    // 15 min (900s)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.sleep_val == 900 ? #00FFE6 : (s900_touch.has-hover ? #2e323d : #1e2025);
                                        border-width: 1px;
                                        border-color: root.sleep_val == 900 ? #00FFE6 : #383b45;
                                        Text {
                                            text: "15 min";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.sleep_val == 900 ? #18191b : #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s900_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.sleep_changed(900); }
                                        }
                                    }

                                    // 30 min (1800s)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.sleep_val == 1800 ? #00FFE6 : (s1800_touch.has-hover ? #2e323d : #1e2025);
                                        border-width: 1px;
                                        border-color: root.sleep_val == 1800 ? #00FFE6 : #383b45;
                                        Text {
                                            text: "30 min";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.sleep_val == 1800 ? #18191b : #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s1800_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.sleep_changed(1800); }
                                        }
                                    }

                                    // Nunca (0s)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.sleep_val == 0 ? #00FFE6 : (s0_touch.has-hover ? #2e323d : #1e2025);
                                        border-width: 1px;
                                        border-color: root.sleep_val == 0 ? #00FFE6 : #383b45;
                                        Text {
                                            text: "Nunca";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.sleep_val == 0 ? #18191b : #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s0_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.sleep_changed(0); }
                                        }
                                    }
                                }
                            }
                        }

                        // Card: USB udev permissions
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Regras de Permissão USB (udev)";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #f1f5f9;
                                        }
                                        Text {
                                            text: root.udev_missing ? "⚠ Regras udev não detectadas. É recomendável instalá-las." : "✓ Regras udev instaladas com sucesso em /etc/udev/rules.d/";
                                            font-size: 11px;
                                            color: root.udev_missing ? #f97316 : #34d399;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        border-radius: 6px;
                                        background: inst_udev_touch.has-hover ? #373a45 : #282a32;
                                        border-width: 1px;
                                        border-color: #383b45;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            Text {
                                                text: "Reinstalar udev";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #e2e8f0;
                                                vertical-alignment: center;
                                            }
                                        }

                                        inst_udev_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.request_install_udev(); }
                                        }
                                    }
                                }
                            }
                        }

                        // Card: Pastas de Armazenamento
                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "Diretórios de Dados";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #f1f5f9;
                                }

                                Rectangle { height: 1px; background: #2f323c; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Perfis e Configurações:"; font-size: 11px; color: #94a3b8; }
                                        Text { text: root.profiles_dir_path; font-size: 11px; color: #cbd5e1; }
                                    }

                                    Rectangle {
                                        height: 26px;
                                        border-radius: 5px;
                                        background: pdir_touch.has-hover ? #00FFE622 : #282a32;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text { text: "Abrir Pasta"; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        }
                                        pdir_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open_profiles_folder(); }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Biblioteca de Ícones:"; font-size: 11px; color: #94a3b8; }
                                        Text { text: root.icons_dir_path; font-size: 11px; color: #cbd5e1; }
                                    }

                                    Rectangle {
                                        height: 26px;
                                        border-radius: 5px;
                                        background: idir_touch.has-hover ? #00FFE622 : #282a32;
                                        border-width: 1px;
                                        border-color: #383b45;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text { text: "Abrir Pasta"; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        }
                                        idir_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open_icons_folder(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 2: SOBRE
                    if root.settings_tab_index == 2: VerticalLayout {
                        spacing: 12px;
                        padding-top: 4px;
                        padding-bottom: 8px;

                        Rectangle {
                            border-radius: 10px;
                            background: #23252d;
                            border-width: 1px;
                            border-color: #2e323d;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 12px;
                                        background: #00FFE6;

                                        Text {
                                            text: "U";
                                            font-weight: 900;
                                            font-size: 24px;
                                            color: #18191b;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Uzlinux Studio";
                                            font-size: 18px;
                                            font-weight: 800;
                                            color: #ffffff;
                                        }
                                        Text {
                                            text: "Versão " + root.app_version_string + " • Linux Nativo";
                                            font-size: 12px;
                                            color: #00FFE6;
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: #2f323c; }

                                Text {
                                    text: "Uzlinux Studio é o ecossistema livre e de alta fidelidade para o Ulanzi D200 Stream Deck em sistemas Linux. Desenvolvido para dispensar a necessidade de emulação Wine ou software oficial de Windows, operando com latência ultrabaixa via protocolo HID direto.";
                                    font-size: 12px;
                                    color: #94a3b8;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "• Protocolo HID direto:"; font-size: 12px; font-weight: 700; color: #cbd5e1; }
                                        Text { text: "Sincronização em tempo real de botões e dial"; font-size: 12px; color: #94a3b8; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "• Controle de Mídia:"; font-size: 12px; font-weight: 700; color: #cbd5e1; }
                                        Text { text: "Compatível com PipeWire, PulseAudio e MPRIS"; font-size: 12px; color: #94a3b8; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "• Interface Gráfica:"; font-size: 12px; font-weight: 700; color: #cbd5e1; }
                                        Text { text: "Slint UI com aceleração de hardware nativa"; font-size: 12px; color: #94a3b8; }
                                    }
                                }

                                Rectangle { height: 1px; background: #2f323c; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: gh_touch.has-hover ? #00FFE622 : #282a32;
                                        border-width: 1px;
                                        border-color: gh_touch.has-hover ? #00FFE6 : #383b45;

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: center;
                                            Text {
                                                text: "Repositório GitHub";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: gh_touch.has-hover ? #00FFE6 : #e2e8f0;
                                                vertical-alignment: center;
                                            }
                                        }

                                        gh_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open_github_repo(); }
                                        }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: mkt_about_touch.has-hover ? #00FFE622 : #282a32;
                                        border-width: 1px;
                                        border-color: mkt_about_touch.has-hover ? #00FFE6 : #383b45;

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: center;
                                            Text {
                                                text: "Marketplace de Ícones";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: mkt_about_touch.has-hover ? #00FFE6 : #e2e8f0;
                                                vertical-alignment: center;
                                            }
                                        }

                                        mkt_about_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open_marketplace(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
